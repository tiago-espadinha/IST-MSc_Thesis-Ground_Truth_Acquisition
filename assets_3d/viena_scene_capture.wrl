DEF floor Transform {
  children [
    Shape {
      geometry PointSet {
        coord Coordinate {
          point 0 0 20
        }
        color Color {
          color 1 0 0
        }
      }
    }
    Shape {
      appearance Appearance {
        texture ImageTexture {
          url "background.jpg" 
        }
      }
      geometry Box {
        size 49 27 0.01
      }
    }
  ]
}

Background {
  skyColor 0 1 1
  skyAngle [0.1, 1.2, 1.57]
  groundColor [
    0.15186 0.8 0.26976,
    0.03474 0.8 0.65881 
  ]
  groundAngle [0.9, 1.5, 1.57]
}

DEF VIENA Transform {
