#VRML V2.0 utf8

DEF cameraMain Viewpoint {
  description "Main Camera"
  position 1.3 -13.5 5
  orientation 1 0 0 1
  fieldOfView 1
}

DEF cameraTop Viewpoint {
  description "Aerial View"
  position 0 5 40
}

DEF vehicle Transform {
  translation 1.7 -8 0
  children Inline{
    url "Viena_capture.wrl"
  }
}

DEF floor Transform {
  children Shape {
    geometry Box {
      size 49 27 0.01
    }
    appearance Appearance {
      texture ImageTexture {
        url "floor_texture.jpg" 
      }
    }
  }
}

Background {
  skyColor 0 1 1
  skyAngle [0.1, 1.2, 1.57]
  groundColor [
    0.15186 0.8 0.26976,
    0.03474 0.8 0.65881 
  ]
  groundAngle [0.9, 1.5, 1.57]
}